 	return 1;
 }
 
+LUA_FUNCTION(Lua_ItemPoolSetCollectibleWeight) {
+	ItemPool* itemPool = lua::GetLuabridgeUserdata<ItemPool*>(L, 1, lua::Metatables::ITEM_POOL, "ItemPool");
+	int itemPoolType = (int)luaL_checkinteger(L, 2);
+	lua_Integer entryIndex = luaL_checkinteger(L, 3);
+	lua_Number weight = luaL_checknumber(L, 4);
+
+	auto* pool = ItemPoolManager::GetItemPool(itemPoolType);
+	if (!pool) {
+		return luaL_argerror(L, 2, "Invalid ItemPoolType");
+	}
+	if (entryIndex < 1 || entryIndex > (lua_Integer)pool->GetPoolData()->_poolList.size()) {
+		return luaL_argerror(L, 3, "Invalid pool entry index");
+	}
+	if (weight <= 0.0) {
+		return luaL_argerror(L, 4, "Weight must be greater than zero");
+	}
+
+	pool->GetPoolData()->_poolList[(size_t)entryIndex - 1]._weight = (float)weight;
+	return 0;
+}
+
 LUA_FUNCTION(Lua_ItemPoolSetLastPool) {
